# Copy to .env. Generate each secret with: openssl rand -hex 64
SECRET_KEY_BASE=
# Hex only: password is interpolated into DATABASE_URL without URL encoding.
POSTGRES_PASSWORD=
APP_HOST=localhost
PORT=3000
# Local HTTP only. Set true behind your HTTPS reverse proxy.
FORCE_SSL=false
# After the first account, sign-up is closed. true lets anyone create an account.
ALLOW_SIGNUP=false
# false stops artifacts loading libraries, fonts and images from outside hosts.
ARTIFACT_EXTERNAL_RESOURCES=true
