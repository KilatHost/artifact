<% version = @draft || @version %>
<% cancel_path = viewer ? public_artifact_path(@artifact.public_id) : artifact_path(@artifact) %>
<div class="edit-workspace">
  <section class="card">
    <div class="card-header">
      <div><h2 class="card-title">Edit draft</h2><p class="card-desc"><%= kind_label(version.kind) %> · based on version <%= @expected_version || @version.number %></p></div>
    </div>
    <div class="card-body">
      <%= form_with model: @artifact, class: "form-stack", data: { controller: "draft-editor", draft_editor_kind_value: version.kind, draft_editor_prefer_source_value: @draft.present? && !@html_text_mode && version.kind == "html", action: "trix-file-accept->draft-editor#rejectAttachment" } do |form| %>
        <%= hidden_field_tag :return_to, "viewer" if viewer %>
        <%= form.hidden_field :expected_version, value: @expected_version || @version.number %>
        <div class="field-group">
          <%= form.label :title, class: "field-label" %>
          <%= form.text_field :title, value: version.title, required: true, maxlength: 200, class: "field" %>
        </div>
        <% if version.kind == "document" %>
          <div>
            <%= form.hidden_field :content, value: version.content, id: "draft-document" %>
            <trix-editor input="draft-document" aria-label="Document" placeholder="Start writing…"></trix-editor>
            <p class="field-hint" role="status" data-draft-editor-target="attachmentStatus"></p>
          </div>
        <% else %>
          <%= render "artifacts/editor_modes", form: form, version: version %>
        <% end %>
        <% unless viewer %>
          <div class="field-group">
            <%= form.label :design_kit_id, "Design kit", class: "field-label" %>
            <%= form.collection_select :design_kit_id, Current.workspace.design_kits.order(:name), :id, :name, { include_blank: "Default" }, class: "field" %>
          </div>
        <% end %>
        <div class="form-actions">
          <%= form.submit "Save draft", class: "button-primary", disabled: @conflict %>
          <%= button_tag "Preview draft", name: "preview", value: "1", formtarget: "draft-preview", formnovalidate: true, class: "button-secondary", data: { turbo: false } %>
          <% if @conflict %>
            <%= link_to "Open latest version", cancel_path, target: "_blank", rel: "noopener", class: "button-ghost" %>
          <% end %>
          <%= link_to "Cancel", cancel_path, class: "button-ghost" %>
        </div>
        <p class="caption"><%= @artifact.public_version_number ? "Saving leaves the public link pinned until you update it." : (@artifact.published_version_id ? "Saving makes it live on the public link." : "Saving keeps it private.") %></p>
      <% end %>
    </div>
  </section>
  <section class="card">
    <div class="card-header">
      <div><h2 class="card-title">Preview</h2><p class="card-desc">Starts at saved version <%= @version.number %>. Preview draft to see your changes.</p></div>
    </div>
    <iframe name="draft-preview" class="preview-frame" title="Draft preview" sandbox="<%= ArtifactRendering::SANDBOX %>" referrerpolicy="no-referrer" src="<%= preview_artifact_path(@artifact, version_id: @version.id) %>"></iframe>
  </section>
</div>
