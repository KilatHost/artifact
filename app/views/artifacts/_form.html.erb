<% kind = version&.kind || artifact.kind || "document" %>
<% content = version&.content.to_s %>
<%= form_with model: artifact, html: { multipart: true, class: "form-stack", data: { controller: "editor", action: "trix-file-accept->editor#rejectAttachment" } } do |form| %>
  <% if artifact.persisted? %><%= form.hidden_field :expected_version, value: artifact.current_version.number %><% end %>
  <div class="form-grid">
    <div class="field-group"><%= form.label :title, class: "field-label" %><%= form.text_field :title, value: version&.title || artifact.title, required: true, maxlength: 200, class: "field" %></div>
    <div class="field-group"><%= form.label :kind, "Format", class: "field-label" %><%= form.select :kind, [ [ "Document", "document" ], [ "HTML", "html" ], [ "File", "file" ] ], { selected: kind }, class: "field", data: { editor_target: "kind", action: "editor#changeKind" } %></div>
    <div class="field-group"><%= form.label :design_kit_id, "Design kit", class: "field-label" %><%= form.collection_select :design_kit_id, Current.workspace.design_kits.order(:name), :id, :name, { include_blank: "Default" }, class: "field" %></div>
  </div>

  <section data-editor-target="document" <%= "hidden" unless kind == "document" %>>
    <input type="hidden" name="artifact[content]" id="document-content" value="<%= content %>" data-editor-target="documentInput" <%= "disabled" unless kind == "document" %>>
    <trix-editor input="document-content" aria-label="Document" placeholder="Start writing…"></trix-editor>
    <p class="field-hint" data-editor-target="status" role="status">To attach a file, make a File artifact.</p>
  </section>

  <section data-editor-target="html" <%= "hidden" unless kind == "html" %>>
    <label for="html-content" class="field-label">HTML source</label>
    <textarea id="html-content" name="artifact[content]" class="field source-editor" rows="22" spellcheck="false" data-editor-target="htmlInput" <%= "disabled" unless kind == "html" %>><%= content %></textarea>
    <p class="field-hint">The preview runs without scripts or outside resources.</p>
  </section>

  <section data-editor-target="file" <%= "hidden" unless kind == "file" %>>
    <div class="field-group">
      <%= form.label :file, artifact.persisted? ? "Replace file" : "File", class: "field-label" %>
      <%= form.file_field :file, disabled: kind != "file", class: "field", data: { editor_target: "fileInput" } %>
      <p class="field-hint"><% if version&.file&.attached? %>Current: <%= version.file.filename %>, <%= number_to_human_size(version.file.byte_size) %>. <% end %>Up to 20 MB.</p>
    </div>
  </section>

  <div class="form-actions">
    <%= form.submit artifact.persisted? ? "Save version" : "Create draft", class: "button-primary" %>
    <span class="caption">Saving keeps it private.</span>
  </div>
<% end %>
