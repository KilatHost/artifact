<% content_for :title, "Connections · Kilat" %>
<div class="page-heading"><div><p class="eyebrow">Agent access</p><h1>Connections</h1><p class="muted">Connect an MCP client using a scoped token or OAuth.</p></div></div>
<% if @new_token.present? %><section class="panel token-reveal" data-turbo-temporary><h2>Copy your token now</h2><p>This secret is shown once. Store it in your client's secret store. Do not share it in artifacts.</p><code class="token-value"><%= @new_token %></code></section><% end %>
<div class="two-column">
  <section class="panel"><h2>Create access token</h2><%= form_with url: connections_path, scope: :connection, class: "stack" do |form| %><div class="field"><%= form.label :name, "Connection name" %><%= form.text_field :name, required: true, maxlength: 255, placeholder: "Local MCP client" %></div><fieldset><legend>Permissions</legend><% { "read" => "Read artifacts and design kits", "write" => "Create and revise private drafts", "publish" => "Publish and unpublish snapshots" }.each do |scope, label| %><label class="checkbox-label"><%= check_box_tag "connection[scopes][]", scope, scope == "read", id: "scope-#{scope}" %><%= label %></label><% end %></fieldset><p class="hint">Publishing is separate from editing. Grant only permissions your client needs.</p><%= form.submit "Create token", class: "button" %><% end %></section>
  <section class="panel"><h2>MCP endpoint</h2><code class="endpoint"><%= request.base_url %>/mcp</code><p class="hint">Use Streamable HTTP with an Authorization: Bearer token. OAuth clients can discover authorization metadata from this server.</p><p class="hint">Client setup varies. No native canvas sync or specific client compatibility is assumed.</p></section>
</div>
<section class="panel section-space"><h2>Active tokens</h2><% if @tokens.any? %><ul class="token-list"><% @tokens.each do |token| %><li><div><strong><%= token.name %></strong><p class="hint"><%= token.scopes %> · Created <%= token.created_at.strftime("%d %b %Y") %></p></div><%= button_to "Revoke", connection_path(token), method: :delete, class: "button secondary", data: { turbo_confirm: "Revoke this token? Connected clients will immediately lose access." } %></li><% end %></ul><% else %><p class="muted">No active tokens. Secrets are never displayed again after creation.</p><% end %></section>
<section class="panel section-space"><h2>OAuth authorizations</h2><% if @oauth_clients.any? %><ul class="token-list"><% @oauth_clients.each do |client| %><li><div><strong><%= client.name %></strong><p class="hint"><%= client.scopes %></p></div><%= button_to "Revoke", connection_path(client.id, oauth: 1), method: :delete, class: "button secondary", data: { turbo_confirm: "Revoke this OAuth authorization? This client will lose access." } %></li><% end %></ul><% else %><p class="muted">No active OAuth authorizations.</p><% end %></section>
