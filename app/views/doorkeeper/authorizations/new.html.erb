<% content_for :title, "Connect #{@pre_auth.client.name} · Kilat Artifact" %>
<section class="auth">
  <div class="card"><div class="card-body form-stack">
    <h1>Connect <%= @pre_auth.client.name %>?</h1>
    <p class="muted">This app asks to use your private workspace. Approve only apps you trust.</p>
    <ul class="scope-list">
      <% @pre_auth.scopes.each do |scope| %>
        <li><%= icon("check") %><div><strong><%= { "read" => "Read", "write" => "Write", "publish" => "Publish" }.fetch(scope.to_s, scope.to_s) %></strong><span class="caption"><%= { "read" => "Read artifacts, history and design kits", "write" => "Create and edit drafts, restore versions, edit design kits", "publish" => "Make a version public and turn public links off" }.fetch(scope.to_s, scope.to_s) %></span></div></li>
      <% end %>
    </ul>
    <p class="caption">After you approve, you go back to <span class="mono"><%= URI(@pre_auth.redirect_uri).host rescue @pre_auth.redirect_uri %></span>.</p>
    <div class="consent-actions">
      <% [ :delete, :post ].each do |verb| %>
        <%= form_tag oauth_authorization_path, method: verb, data: { turbo: false } do %>
          <% %i[redirect_uri state response_type response_mode scope code_challenge code_challenge_method].each do |field| %>
            <%= hidden_field_tag field, @pre_auth.public_send(field), id: nil %>
          <% end %>
          <%= hidden_field_tag :client_id, @pre_auth.client.uid, id: nil %>
          <%= submit_tag(verb == :post ? "Approve" : "Deny", class: "#{verb == :post ? 'button-primary' : 'button-secondary'} button-block") %>
        <% end %>
      <% end %>
    </div>
  </div></div>
</section>
